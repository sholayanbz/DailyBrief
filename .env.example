# ── Anthropic API ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6        # optional, this is the default

# ── GexBot API ────────────────────────────────────────────────────────────────
GEXBOT_API_KEY=your-gexbot-key-here
GEXBOT_BASE_URL=https://api.gexbot.com   # optional, this is the default
GEX_PERIOD=full                          # optional: full | zero | one

# ── SendGrid ──────────────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.xxxx...
FROM_EMAIL=you@yourdomain.com           # verified sender — same as scanner project
# Recipients are loaded from emails.txt (same as scanner project)

# ── Storage ───────────────────────────────────────────────────────────────────
# Mount a Railway persistent volume at this path so files survive between runs.
DATA_DIR=/data/brief
